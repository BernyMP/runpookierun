# Web app: copy to .env.local. Never commit real keys.
POOKIE_ENVIRONMENT=staging
# Names of YOUR isolated Convex deployments (no URL). Required for hosted guards.
POOKIE_STAGING_DEPLOYMENT=
POOKIE_PRODUCTION_DEPLOYMENT=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PAID_PLAN_ID=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/pookie
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/pookie
SITE_URL=https://runpookierun.com
# off (default), prototype (unlisted guide/sample only), enabled (public).
# Keep production off until physical iPhone/Watch verification: docs/apple-watch.md.
NEXT_PUBLIC_APPLE_WATCH_EXPORTS=off
# Optional website ownership verification tokens (not service API secrets).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Also configure these on the NEW Convex deployment, not the legacy test deployment.
# CLERK_SECRET_KEY must also be set on Convex for subscription reconciliation.
# Do not place the remaining backend secrets on Vercel.
CLERK_JWT_ISSUER_DOMAIN=
CLERK_PAID_PLAN_ID=
CLERK_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
APP_URL=https://runpookierun.com
# Random signing secret, at least 32 characters; Convex only. Never NEXT_PUBLIC.
WEEKLY_REMINDER_SECRET=
# Optional, server-side analytics only. No personal notes or session replay.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Owner-only editorial controls. Clerk user IDs, comma separated; Convex only.
POOKIE_EDITOR_CLERK_IDS=
# Dedicated worker secret, >=32 chars. Convex and local Eve only; never Vercel.
POOKIE_EDITOR_WORKER_SECRET=

# Optional advertising: OFF until Meta Events Manager verification and category review.
# Web/Vercel (public identifier only; no access token here):
NEXT_PUBLIC_META_ENABLED=false
NEXT_PUBLIC_META_PIXEL_ID=
# Convex ONLY. Enable separately after installing the matching dataset credentials.
META_ENABLED=false
META_PIXEL_ID=
META_ACCESS_TOKEN=
# Set an explicitly supported Graph API version when connecting the dataset.
META_API_VERSION=
# Explicit allowlist after checking dataset restrictions; example:
# META_ALLOWED_EVENTS=CompleteRegistration,StartTrial,Purchase
META_ALLOWED_EVENTS=
# Test Events code only during verification; clear before real ad traffic.
META_TEST_EVENT_CODE=
