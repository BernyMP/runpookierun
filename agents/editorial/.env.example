# The NEW Pookie Convex HTTP origin, ending in .convex.site. Never the legacy backend.
POOKIE_EDITOR_CONVEX_URL=
# Same dedicated secret as the NEW Pookie Convex deployment; >=32 characters.
POOKIE_EDITOR_WORKER_SECRET=
# Optional absolute path to a Node 24+ binary for the local worker.
POOKIE_NODE_BINARY=

# Deployment names used by launch verification.
POOKIE_STAGING_DEPLOYMENT=
POOKIE_PRODUCTION_DEPLOYMENT=
