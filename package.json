{
  "name": "run-pookie-run",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "postbuild": "next-sitemap",
    "start": "next start",
    "lint": "eslint app components convex domain libs tests --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "verify:launch": "node scripts/check-launch.mjs",
    "format": "prettier --write app components convex domain libs tests scripts docs *.ts *.json *.js *.md",
    "test:editorial-live": "POOKIE_LIVE_EDITORIAL=1 vitest run tests/editorial-live.test.ts",
    "check:public": "node scripts/check-public-release.mjs"
  },
  "dependencies": {
    "@bibixx/workoutkit": "0.2.0",
    "@clerk/backend": "3.18.1",
    "@clerk/nextjs": "6.39.7",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@vercel/analytics": "^1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "1.46.0",
    "lucide-react": "^0.515.0",
    "next": "15.5.25",
    "next-sitemap": "^4.2.3",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "resend": "^6.0.0",
    "svix": "^1.70.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@clerk/testing": "2.2.36",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.19",
    "convex-test": "0.0.59",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.25",
    "postcss": "^8.5.23",
    "prettier": "^3.9.8",
    "tailwindcss": "^3.4.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "$postcss",
    "picomatch@<2.3.2": "^2.3.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BernyMP/runpookierun.git"
  },
  "bugs": {
    "url": "https://github.com/BernyMP/runpookierun/issues"
  }
}
